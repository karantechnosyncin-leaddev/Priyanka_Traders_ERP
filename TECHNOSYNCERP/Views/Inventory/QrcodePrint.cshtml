            })
        }
        // Logs
        {
            $("#btnPrintingLog").click(function () {
                $("#frefno,#rrefno").val("");
                $('.datepicker').val(new Date().toISOString().split('T')[0]);
                Findmode();
            });

            $("#FindBtnSearch").click(function () {
                Findmode();
            });

            $("#FindBtnReset").click(function () {
                $("#frefno,#rrefno").val("");
                $("#ffromdate,#ftodate,#flogtype").val("");
            });

            function Findmode() {
                var obj = {
                    type: $("#flogtype").val() || '',
                    fromdate: $("#ffromdate").val() || '',
                    todate: $("#ftodate").val() || ''
                };

                $.ajax({
                    url: '@Url.Action("GETSTIKERPRINTLOG", "Inventory")',
                    method: 'GET',
                    data: obj,
                    success: function (response) {

                        const table = $('#logtable');

                        // Destroy existing DataTable safely
                        if ($.fn.DataTable.isDataTable(table)) {
                            table.DataTable().clear().destroy();
                        }

                        const tableBody = table.find('tbody');
                        tableBody.empty();

                        if (!response || response.length === 0) {
                            return;
                        }

                        response.forEach(function (receipt) {
                            const row = `
                                <tr data-docentry="${receipt.GRPO_DocEntry || ''}">
                                    <td>${receipt.ItemCode || ''}</td>
                                    <td>${receipt.ItemName || ''}</td>
                                    <td>${receipt.EmployeeName || ''}</td>
                                    <td>${receipt.GRPO_NO || ''}</td>
                                    <td>${parseInt(receipt.GRPO_QTY) || 0}</td>
                                    <td>${parseInt(receipt.Printed_QTY) || 0}</td>
                                    <td>${receipt.TabType || ''}</td>
                                    <td>${receipt.CreateDateFormatted || receipt.CreateDate || ''}</td>
                                    <td>${receipt.CretedByUName || ''}</td>
                                </tr>
                            `;
                            tableBody.append(row);
                        });

                        // Reinitialize DataTable
                        table.DataTable({
                            dom: '<"top"lf>rt<"bottom"ip>',
                            pageLength: 10,
                            lengthMenu: [5, 10, 25, 50, 100],
                            responsive: true,
                            order: [[7, 'desc']], // Create Date
                            columnDefs: [
                                { orderable: false, targets: [] }
                            ]
                        });
                    },
                    error: function () {
                        Notify('error', 'Failed to load receipt list', '');
                    }
                });
            }
        }
        //PRIVIEW BAR CODE
        {
                // Update QR preview on input change
                $('#txtItemCode, #txtItemName, #itemSalesEmployee').on('input change', updateQRPreview);

                // Update Barcode preview on input change
                $('#boxTabCode, #boxTabName, #boxSalesEmployee, #boxQuantity, #boxCopies').on('input change', updateBarcodePreview);

                // Update QR Preview function
                function updateQRPreview() {
                    const itemCode = $('#txtItemCode').val().trim();
                    const itemName = $('#txtItemName').val().trim();
                    const salesEmployee = $('#itemSalesEmployee').val();

                    // Update preview details
                    $('#previewItemCode').text(itemCode || 'Not set');
                    $('#previewItemName').text(itemName || 'Not set');
                    $('#previewSalesEmployee').text(salesEmployee === '-No Sales Employee-' ? 'Not set' : salesEmployee);

                    // If all required fields are filled, generate preview
                    if (itemCode && itemName && salesEmployee !== '-No Sales Employee-') {
                        generateQRCodePreview(itemCode, itemName, salesEmployee);
                    } else {
                        // Show placeholder if not all fields are filled
                        $('#qrPreviewPlaceholder').removeClass('d-none');
                        $('#qrPreviewCanvas').addClass('d-none');
                        $('#qrPreviewImage').addClass('d-none');
                        $('#downloadQrCode').prop('disabled', true);
                    }
                }

               // Generate QR Code preview
            function generateQRCodePreview(code, name, employee) {

                $('#qrPreviewPlaceholder').addClass('d-none');
                function lineBreakAfter2UnderscoreAndSpace(text, maxLength = 17) {
                    text = text.replace(/_/g, ' ');
                    const words = text.split(' ');
                    let result = '';
                    let line = '';

                    for (let word of words) {
                        if ((line + ' ' + word).trim().length <= maxLength) {
                            line += (line ? ' ' : '') + word;
                        } else {
                            result += line + '<br>';
                            line = word;
                        }
                    }
                    if (line) result += line;
                    return result;
                }

                // Clear preview first
                const container = $('#qrmainpriview');

                // Hide placeholder & show preview
                $('#qrPreviewPlaceholder').addClass('d-none');
                container.empty().removeClass('d-none');

                // Create centered preview card
                const row = $(`
<div class=" rounded d-flex justify-content-center align-items-center w-100 h-100">
    <div class="row w-100 shadow-sm bg-white border rounded p-2 align-items-center"
         style="min-height:120px">

        <!-- LEFT TEXT -->
        <div class="col-8 fw-bold text-start">
            ${lineBreakAfter2UnderscoreAndSpace(name)}
        </div>

        <!-- RIGHT QR -->
        <div class="col-4 d-flex flex-column align-items-end text-end">
            <div id="qrBox" class="mb-1"></div>
            <div class="fw-bold">${code}</div>
            <div class="small">S. (${employee})</div>
        </div>

    </div>
</div>
`);
                container.append(row);
                new QRCode(row.find('#qrBox')[0], {
                    text: code,
                    width: 60,
                    height: 60,
                    correctLevel: QRCode.CorrectLevel.H
                });
                $("#generateItemQR,#downloadQrCode").prop("disabled", false);
            }



                // Update Barcode Preview function
                function updateBarcodePreview() {
                    const itemCode = $('#boxTabCode').val().trim();
                    const itemName = $('#boxTabName').val().trim();
                    const salesEmployee = $('#boxSalesEmployee').val();
                    const quantity = $('#boxQuantity').val();
                    const copies = $('#boxCopies').val();

                    // Update preview details
                    $('#previewBoxCode').text(itemCode || 'Not set');
                    $('#previewBoxName').text(itemName || 'Not set');
                    $('#previewBoxSalesEmployee').text(salesEmployee === '-No Sales Employee-' ? 'Not set' : salesEmployee);
                    $('#previewBoxQuantity').text(quantity || '-');
                    $('#previewBoxCopies').text(copies || '1');

                    // If item code is filled, generate barcode preview
                    if (itemCode) {
                        generateBarcodePreview(itemCode, itemName, salesEmployee, quantity, copies);
                    } else {
                        // Show placeholder if no item code
                        $('#barcodePreviewPlaceholder').removeClass('d-none');
                        $('#barcodePreviewCanvas').addClass('d-none');
                        $('#barcodePreviewImage').addClass('d-none');
                        $('#downloadBarcode').prop('disabled', true);
                        $('#printBarcode').prop('disabled', true);
                    }
                }
                // Generate Barcode preview
            // Generate Barcode preview
            function generateBarcodePreview(code, name, employee, quantity, copies) {

                const container = $('#BarcodePreviewImage');

                // Show preview container, hide placeholder
                $('#barcodePreviewPlaceholder').addClass('d-none');
                container.removeClass('d-none').empty();

                try {
                    // Create SVG for barcode
                    const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");

                    JsBarcode(svg, code, {
                        format: "CODE128",
                        width: 1.5,
                        height: 40,
                        displayValue: true,
                        fontSize: 12
                    });

                    // Build preview HTML
                    const html = `
        <div class="d-flex justify-content-center align-items-center">
            <div class="bg-white rounded p-2 text-center w-100 shadow-sm">

                <div class="fw-bold mb-1">
                    ${name || ''}
                </div>

                <div class="mb-1">
                    ${svg.outerHTML}
                </div>

                <div class="fw-bold">
                    ${code}_${quantity}
                </div>

                <div class="small">
                    S. (${employee})
                </div>

            </div>
        </div>`;

                    container.html(html);

                    // Enable actions
                    $('#downloadBarcode, #generateBoxBarcode').prop('disabled', false);

                } catch (error) {
                    console.error('Barcode generation error:', error);

                    // Restore placeholder on error
                    container.addClass('d-none');
                    $('#barcodePreviewPlaceholder').removeClass('d-none');
                    $('#downloadBarcode, #generateBoxBarcode').prop('disabled', true);
                }
            }

                // Download QR Code
                $('#downloadQrCode').on('click', function () {
                    const itemCode = $('#txtItemCode').val().trim() || 'item';
                    const element = document.getElementById('qrmainpriview');

                    html2canvas(element, {
                        backgroundColor: '#ffffff', // ensures white background
                        scale: 2 // better image quality
                    }).then(canvas => {
                        const link = document.createElement('a');
                        link.download = `qr-code-${itemCode}-${Date.now()}.png`;
                        link.href = canvas.toDataURL('image/png');
                        link.click();
                    });
                });


                // Download Barcode
            // Download Barcode as Image
            $('#downloadBarcode').on('click', function () {

                const itemCode = $('#boxTabCode').val().trim() || 'barcode';
                const element = document.getElementById('BarcodePreviewImage');

                if (!element || element.classList.contains('d-none')) {
                    alert('Barcode preview not available');
                    return;
                }

                html2canvas(element, {
                    backgroundColor: '#ffffff',
                    scale: 2   // High quality image
                }).then(canvas => {

                    const link = document.createElement('a');
                    link.download = `barcode-${itemCode}-${Date.now()}.png`;
                    link.href = canvas.toDataURL('image/png');
                    link.click();

                }).catch(err => {
                    console.error('Barcode download failed:', err);
                });
            });


                // Print Barcode
                $('#printBarcode').on('click', function () {
                    const itemCode = $('#boxTabCode').val().trim();
                    const itemName = $('#boxTabName').val().trim();
                    const quantity = $('#boxQuantity').val();
                    const printWindow = window.open('', '_blank');
                    printWindow.document.write(`

                                <style>
                                    body { text-align: center; padding: 20px; }
                                    img { max-width: 100%; height: auto; }
                                    .details { text-align: left; margin-top: 20px; font-family: Arial, sans-serif; }
                                </style>

                                <h3>Barcode - ${itemName || itemCode || 'Item'}</h3>
                                <img src="${$('#barcodePreviewImage').attr('src')}">
                                <div class="details">
                                    <p><strong>Item Code:</strong> ${itemCode || 'N/A'}</p>
                                    <p><strong>Item Name:</strong> ${itemName || 'N/A'}</p>
                                    <p><strong>Quantity:</strong> ${quantity || 'N/A'}</p>
                                    <p><strong>Generated:</strong> ${new Date().toLocaleString()}</p>
                                </div>
                                <script>
                                    window.onload = function() { window.print(); }
                                <\/script>

                    `);
                    printWindow.document.close();
                });

                // Generate QR Code button click
                $('#generateItemQR').on('click', updateQRPreview);

                // Generate Barcode button click
                $('#generateBoxBarcode').on('click', updateBarcodePreview);

                // Initialize previews
                updateQRPreview();
                updateBarcodePreview();
        }
    });
    </script>
