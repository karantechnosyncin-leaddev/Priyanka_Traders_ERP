                $activeGrpoSalesEmployeeInput
                    .val(empName)
                    .attr('data-empid', empId.toString())   // ⭐ STORE EmployeeID HERE
                    .attr('data-code', empCode); // optional

                // Hide suggestions
                $('.suggestions-container').hide();
